# ============================================================
# Hangout API — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# App
NODE_ENV=development
PORT=3001
APP_NAME=Hangout
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Use local Docker for development:
DATABASE_URL=postgresql://hangout:hangout_secret@localhost:5432/hangout_db
# Use Supabase connection pooler for production:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://hangout:hangout_secret@localhost:5432/hangout_db

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:hangout_redis_secret@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=hangout_redis_secret

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=hangout_media

# ── LiveKit ──────────────────────────────────────────────────
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@hangout.app

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ── Security ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:3000,https://hangout.app

# ── AI (Google Gemini) ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# ── Storage (local MinIO or Supabase) ───────────────────────
STORAGE_PROVIDER=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=hangout_minio
MINIO_SECRET_KEY=hangout_minio_secret
MINIO_BUCKET=hangout-media

# ── Feature Flags ────────────────────────────────────────────
ENABLE_AI_FEATURES=true
ENABLE_VOICE_ROOMS=true
ENABLE_VIDEO_CALLS=true
ENABLE_CINEMA_ROOM=true
ENABLE_ARCADE=true
ENABLE_TIME_CAPSULE=true
