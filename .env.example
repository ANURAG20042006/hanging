# ============================================================
# Hangout Platform — Production Environment Configuration
# ============================================================

# App Configuration
PORT=3001
NODE_ENV=production
CORS_ORIGINS=http://localhost:3000,https://hangout.app,https://api.hangout.app

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hangout?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hangout?schema=public"

# Redis Cache & Socket Adapter
REDIS_URL="redis://localhost:6379"

# Authentication Secrets
JWT_SECRET="hangout_super_secret_jwt_key_2026_production_grade_token"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="hangout_super_secret_refresh_key_2026"

# LiveKit WebRTC Voice/Video
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_URL="ws://localhost:7880"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="hangout-cloud"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz"

# Supabase Admin Fallback
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email Services (Resend)
RESEND_API_KEY="re_123456789"
FROM_EMAIL="noreply@hangout.app"

# Monitoring & OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
PROMETHEUS_METRICS_PORT=9090
